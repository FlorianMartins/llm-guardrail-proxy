# Backend provider: openai (any OpenAI-compatible API) | azure | anthropic
GUARD_BACKEND_PROVIDER=openai
GUARD_BACKEND_URL=http://localhost:11434/v1        # Ollama
# GUARD_BACKEND_URL=https://api.openai.com/v1
# GUARD_BACKEND_URL=https://my-resource.openai.azure.com   # with GUARD_BACKEND_PROVIDER=azure
# (anthropic: leave GUARD_BACKEND_URL unset)
# GUARD_BACKEND_API_KEY=...
# GUARD_AZURE_API_VERSION=2024-10-21
# GUARD_ANTHROPIC_MAX_TOKENS=16000
GUARD_BACKEND_TIMEOUT_S=60

# Client authentication for the proxy (JSON list). Leave unset for local dev only.
# GUARD_PROXY_API_KEYS=["change-me"]

# Policies
GUARD_INJECTION_ACTION=block      # block | flag
GUARD_INJECTION_THRESHOLD=0.8
GUARD_MASK_PII=true
GUARD_OUTPUT_ACTION=redact        # block | redact | flag
GUARD_MAX_BODY_BYTES=1000000

# Logging
GUARD_LOG_LEVEL=INFO
# GUARD_LOG_FILE=/var/log/guardrail/audit.jsonl
